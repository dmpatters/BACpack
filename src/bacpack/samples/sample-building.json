        {"object_type": "schedule", "instance_number": 1, "name": "Occupancy Schedule", "schedule_value_type": "binary", "schedule_default": "inactive",
         "weekly_schedule": [
           [{"time": "07:00", "value": "active"}, {"time": "18:00", "value": "inactive"}],
           [{"time": "07:00", "value": "active"}, {"time": "18:00", "value": "inactive"}],
           [{"time": "07:00", "value": "active"}, {"time": "18:00", "value": "inactive"}],
           [{"time": "07:00", "value": "active"}, {"time": "18:00", "value": "inactive"}],
           [{"time": "07:00", "value": "active"}, {"time": "18:00", "value": "inactive"}],
           [],
           []
         ],
         "exception_schedule": [
           {"period": {"kind": "calendar-reference", "instance_number": 1}, "priority": 1, "time_values": [{"time": "00:00", "value": "inactive"}]}
         ],
         "schedule_priority": 14,
         "schedule_write_targets": [{"object_type": "binary-value", "instance_number": 1, "property_identifier": "presentValue"}]},
        {"object_type": "calendar", "instance_number": 1, "name": "Holidays",
